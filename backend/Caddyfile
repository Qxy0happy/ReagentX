# ReagentX Caddy 配置
#
# 开发环境（推荐，免配置）：
#   cd backend
#   go run . &
#   caddy reverse-proxy --from localhost:8080 --to localhost:8081
#
# 生产环境（Docker）：
#   docker compose up -d
#
# 环境变量 UPSTREAM_ADDR：
#   Docker → go-backend:8081
#   本地   → localhost:8081（默认值）

:8080 {
	# {env.VAR:default} 是 Caddy 引用环境变量的标准语法
	reverse_proxy {env.UPSTREAM_ADDR:localhost:8081}

	handle_path /uploads/* {
		reverse_proxy {env.UPSTREAM_ADDR:localhost:8081}
	}

	log {
		output stdout
	}
}
