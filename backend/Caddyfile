# ReagentX Caddy 配置
#
# 生产环境：
#   1. 把 example.com 换成实际域名
#   2. 删除 tls internal 行（Caddy 自动从 Let's Encrypt 申请证书）
#   3. 确保 80/443 端口可访问
#   4. caddy run
#
# 开发环境（自签名证书）：
#   1. caddy run
#   2. 首次会提示信任自签名 CA（按说明操作）
#   3. 手机安装 Caddy 的根证书 → 见 https://caddyserver.com/docs/automatic-https#local-https
#
# 环境变量 UPSTREAM_ADDR：
#   Docker → go-backend:8081
#   本地   → localhost:8081（默认值）
{
	# 关闭 80 端口自动重定向（Android Termux 非 root 无法绑定特权端口）
	auto_https disable_redirects
}

:8080 {
	tls internal

	# {env.VAR:default} 是 Caddy 引用环境变量的标准语法
	reverse_proxy {env.UPSTREAM_ADDR:localhost:8081}

	handle_path /uploads/* {
		reverse_proxy {env.UPSTREAM_ADDR:localhost:8081}
	}

	log {
		output stdout
	}
}
