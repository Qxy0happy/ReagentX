<?xml version="1.0" encoding="utf-8"?>
<!--
  开发环境：信任用户安装的 CA（Caddy tls internal 自签名证书）
  发布时：改为信任系统证书即可（Caddy 的 Let's Encrypt 自动证书受信任）
-->
<network-security-config>
    <base-config>
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
